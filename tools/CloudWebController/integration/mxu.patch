diff --git a/src/utils/cloudWebController.ts b/src/utils/cloudWebController.ts
new file mode 100644
index 0000000..cc99d45
--- /dev/null
+++ b/src/utils/cloudWebController.ts
@@ -0,0 +1,61 @@
+import type { CloudWebControllerConfig } from '@/types/maa';
+
+/** Empty is intentional: the backend loads its bundled, offline verification page. */
+export function isValidCloudWebUrl(value: unknown): value is string {
+  if (typeof value !== 'string') return false;
+  const url = value.trim();
+  if (!url) return true;
+  // Match the native host contract: bounded ASCII HTTPS, default TLS port only.
+  if (url.length > 4096 || /[^\x21-\x7e]/.test(url) || url.includes('\\')) return false;
+  try {
+    const parsed = new URL(url);
+    return (
+      parsed.protocol === 'https:' &&
+      !!parsed.hostname &&
+      !parsed.username &&
+      !parsed.password &&
+      (!parsed.port || parsed.port === '443')
+    );
+  } catch {
+    return false;
+  }
+}
+
+/** One builder for manual connection and toolbar/scheduled-start reconnects. */
+export function buildCloudWebControllerConfig(
+  instanceId: string,
+  url = '',
+): CloudWebControllerConfig {
+  if (!isValidCloudWebUrl(url)) throw new Error('CLOUD_WEB_INVALID_URL');
+  if (!/^[a-zA-Z0-9_:-]{1,128}$/.test(instanceId)) throw new Error('CLOUD_WEB_INVALID_SESSION');
+  return { type: 'CloudWeb', url: url.trim(), session_id: instanceId };
+}
+
+/** Never put URL query strings, fragments or login data into connection logs. */
+export function getCloudWebDeviceName(url: string | undefined, fixtureLabel: string): string {
+  if (typeof url !== 'string' || !url.trim() || !isValidCloudWebUrl(url)) return fixtureLabel;
+  return new URL(url.trim()).host;
+}
+
+/** Bridge codes are intentionally data-free and localized at the service boundary. */
+export function getCloudWebErrorKey(error: unknown): string | undefined {
+  const message = error instanceof Error ? error.message : String(error);
+  const code = message.match(/\bCLOUD_WEB_[A-Z_]+\b/)?.[0];
+  if (!code) return undefined;
+  const keys: Record<string, string> = {
+    CLOUD_WEB_INVALID_URL: 'cloudWebInvalidUrl',
+    CLOUD_WEB_INVALID_SESSION: 'cloudWebConnectionFailed',
+    CLOUD_WEB_HOST_MISSING: 'cloudWebHostMissing',
+    CLOUD_WEB_START_FAILED: 'cloudWebConnectionFailed',
+    CLOUD_WEB_PROTOCOL_ERROR: 'cloudWebConnectionFailed',
+    CLOUD_WEB_TIMEOUT: 'cloudWebTimeout',
+    CLOUD_WEB_DISCONNECTED: 'cloudWebDisconnected',
+    CLOUD_WEB_BUSY: 'cloudWebBusy',
+    CLOUD_WEB_REJECTED: 'cloudWebConnectionFailed',
+    CLOUD_WEB_RECONNECT_RUNNING: 'cloudWebBusy',
+    CLOUD_WEB_RELEASE_FAILED: 'cloudWebReleaseFailed',
+    CLOUD_WEB_ELEVATED: 'cloudWebElevated',
+    CLOUD_WEB_CREATE_FAILED: 'cloudWebConnectionFailed',
+  };
+  return `controller.${keys[code] || 'cloudWebConnectionFailed'}`;
+}
diff --git a/src/utils/cloudWebManifest.ts b/src/utils/cloudWebManifest.ts
new file mode 100644
index 0000000..5efa364
--- /dev/null
+++ b/src/utils/cloudWebManifest.ts
@@ -0,0 +1,101 @@
+import type { ProjectInterface } from '@/types/interface';
+
+/** Client-only extension. This is never read from or written into PI interface.json. */
+export interface CloudWebManifest {
+  schema_version: 1;
+  controller: { name: 'CloudWeb'; label: string };
+  compatible_tasks: string[];
+  compatible_options?: string[];
+}
+
+function hasOnlyKeys(value: Record<string, unknown>, keys: string[]): boolean {
+  return Object.keys(value).every((key) => keys.includes(key));
+}
+
+export function parseCloudWebManifest(value: unknown): CloudWebManifest {
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
+    throw new Error('CLOUD_WEB_INVALID_MANIFEST');
+  }
+  const manifest = value as Record<string, unknown>;
+  const controller = manifest.controller as Record<string, unknown> | null;
+  if (
+    !hasOnlyKeys(manifest, [
+      'schema_version',
+      'controller',
+      'compatible_tasks',
+      'compatible_options',
+    ]) ||
+    manifest.schema_version !== 1 ||
+    !controller ||
+    typeof controller !== 'object' ||
+    Array.isArray(controller) ||
+    !hasOnlyKeys(controller, ['name', 'label']) ||
+    controller.name !== 'CloudWeb' ||
+    typeof controller.label !== 'string' ||
+    !controller.label.trim() ||
+    controller.label.length > 256 ||
+    !Array.isArray(manifest.compatible_tasks) ||
+    !manifest.compatible_tasks.every((name) => typeof name === 'string' && !!name.trim()) ||
+    new Set(manifest.compatible_tasks).size !== manifest.compatible_tasks.length ||
+    (manifest.compatible_options !== undefined &&
+      (!Array.isArray(manifest.compatible_options) ||
+        !manifest.compatible_options.every((name) => typeof name === 'string' && !!name.trim()) ||
+        new Set(manifest.compatible_options).size !== manifest.compatible_options.length))
+  )
+    throw new Error('CLOUD_WEB_INVALID_MANIFEST');
+  return {
+    schema_version: 1,
+    controller: { name: 'CloudWeb', label: controller.label },
+    compatible_tasks: [...manifest.compatible_tasks] as string[],
+    ...(manifest.compatible_options
+      ? { compatible_options: [...(manifest.compatible_options as string[])] }
+      : {}),
+  };
+}
+
+/** Return a runtime copy. The original PI and imported task declarations remain unchanged. */
+export function applyCloudWebManifest(pi: ProjectInterface, value: unknown): ProjectInterface {
+  const manifest = parseCloudWebManifest(value);
+  if (pi.controller.some((controller) => controller.name === 'CloudWeb')) {
+    throw new Error('CLOUD_WEB_CONTROLLER_NAME_CONFLICT');
+  }
+  const allowed = new Set(manifest.compatible_tasks);
+  const taskNames = new Set(pi.task.map((task) => task.name));
+  if (manifest.compatible_tasks.some((name) => !taskNames.has(name))) {
+    throw new Error('CLOUD_WEB_UNKNOWN_COMPATIBLE_TASK');
+  }
+  const originalControllerNames = pi.controller.map((controller) => controller.name);
+  const allowedOptions = new Set(manifest.compatible_options ?? []);
+  if ([...allowedOptions].some((name) => !pi.option?.[name])) {
+    throw new Error('CLOUD_WEB_UNKNOWN_COMPATIBLE_OPTION');
+  }
+  return {
+    ...pi,
+    controller: [...pi.controller, { ...manifest.controller, type: 'CloudWeb' }],
+    option: pi.option
+      ? Object.fromEntries(
+          Object.entries(pi.option).map(([name, option]) => [
+            name,
+            allowedOptions.has(name)
+              ? {
+                  ...option,
+                  controller: [
+                    ...(option.controller?.length ? option.controller : originalControllerNames),
+                    'CloudWeb',
+                  ],
+                }
+              : option,
+          ]),
+        )
+      : undefined,
+    task: pi.task.map((task) => {
+      // Unrestricted existing tasks remain available to the original controllers only,
+      // unless explicitly allowlisted for the new browser backend.
+      const controllers = task.controller?.length ? task.controller : originalControllerNames;
+      return {
+        ...task,
+        controller: allowed.has(task.name) ? [...controllers, 'CloudWeb'] : [...controllers],
+      };
+    }),
+  };
+}
