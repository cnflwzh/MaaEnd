+//! Product-owned embedded browser controller. The remote page never receives an
+//! MXU API, executable path, socket, or MaaFramework handle.
+//!
+//! Only the browser surface lives in the child process. The existing MXU
+//! Controller, Resource, Tasker and AgentClient objects stay in this process.
+
+use base64::{engine::general_purpose::STANDARD, Engine};
+use maa_framework::controller::Controller;
+use maa_framework::custom_controller::CustomControllerCallback;
+use serde::Deserialize;
+use serde_json::{json, Value};
+use std::io::{BufRead, BufReader, Write};
+use std::path::Path;
+use std::process::{Child, Command, Stdio};
+use std::sync::atomic::{AtomicBool, AtomicU64, AtomicUsize, Ordering};
+use std::sync::{mpsc, Arc, Mutex, Weak};
+use std::time::{Duration, Instant};
+
+const MAX_REQUEST_BYTES: usize = 64 * 1024;
+const MAX_RESPONSE_BYTES: usize = 8 * 1024 * 1024;
+const ACTION_TIMEOUT: Duration = Duration::from_secs(12);
+const CONNECT_TIMEOUT: Duration = Duration::from_secs(35);
+const STATUS_TIMEOUT: Duration = Duration::from_secs(2);
+
+#[derive(Debug, Deserialize)]
+struct HostReply {
+    id: u64,
+    ok: bool,
+    #[serde(default)]
+    result: Value,
+    #[serde(default)]
+    error: Option<String>,
+}
+
+struct HostRequest {
+    id: u64,
+    line: Vec<u8>,
+    deadline: Instant,
+    reply: mpsc::SyncSender<Result<HostReply, String>>,
+}
+
+/// Explicit owner: MaaFramework 1.22 does not reclaim its boxed custom callback.
+/// Callbacks hold only Weak references, so dropping the instance closes/reaps
+/// the browser even while MaaFramework retains a callback allocation.
+pub struct CloudWebSession {
+    child: Mutex<Option<Child>>,
+    requests: mpsc::SyncSender<HostRequest>,
+    healthy: Arc<AtomicBool>,
+    ready: AtomicBool,
+    input_enabled: AtomicBool,
+    input_gate: Mutex<()>,
+    request_gate: Mutex<()>,
+    stop_epoch: AtomicU64,
+    pending_releases: AtomicUsize,
+    next_id: AtomicU64,
+    session_id: String,
+}
+
+fn normalized_url(url: &str) -> Result<String, String> {
+    if url.is_empty() || url == "bundled-fixture" {
+        return Ok("bundled-fixture".into());
+    }
+    if url.len() > 4096 || !url.is_ascii() || url.bytes().any(|b| b <= 32 || b == b'\\') {
+        return Err("CLOUD_WEB_INVALID_URL".into());
+    }
+    let parsed = reqwest::Url::parse(url).map_err(|_| "CLOUD_WEB_INVALID_URL")?;
+    if parsed.scheme() != "https"
+        || parsed.host_str().is_none()
+        || !parsed.username().is_empty()
+        || parsed.password().is_some()
+        || parsed.port().is_some_and(|port| port != 443)
+    {
+        return Err("CLOUD_WEB_INVALID_URL".into());
+    }
+    Ok(url.to_string())
+}
+
+/// Read one bounded line without allowing read_until to allocate unbounded data.
+fn read_bounded_line<R: BufRead>(reader: &mut R, limit: usize) -> Result<Vec<u8>, String> {
+    let mut result = Vec::new();
+    loop {
+        let available = reader.fill_buf().map_err(|_| "CLOUD_WEB_PROTOCOL_ERROR")?;
+        if available.is_empty() {
+            return Err("CLOUD_WEB_DISCONNECTED".into());
+        }
+        let end = available.iter().position(|&b| b == b'\n');
+        let take = end.map_or(available.len(), |index| index + 1);
+        if result.len().saturating_add(take) > limit {
+            return Err("CLOUD_WEB_PROTOCOL_ERROR".into());
+        }
+        result.extend_from_slice(&available[..take]);
+        reader.consume(take);
+        if end.is_some() {
+            return Ok(result);
+        }
+    }
+}
+
+impl CloudWebSession {
+    pub fn is_healthy(&self) -> bool {
+        self.healthy.load(Ordering::Acquire)
+    }
+
+    fn spawn(executable: &Path, url: &str, session_id: &str) -> Result<Arc<Self>, String> {
+        let url = normalized_url(url)?;
+        if session_id.is_empty()
+            || session_id.len() > 128
+            || !session_id
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b"-_:".contains(&b))
+        {
+            return Err("CLOUD_WEB_INVALID_SESSION".into());
+        }
+        if !executable.is_file() {
+            return Err("CLOUD_WEB_HOST_MISSING".into());
+        }
+        let mut command = Command::new(executable);
+        command
+            .arg("--mxu-host")
+            .arg("--url")
+            .arg(url)
+            .arg("--session-id")
+            .arg(session_id)
+            .arg("--profile-root")
+            .arg(
+                executable
+                    .parent()
+                    .and_then(Path::parent)
+                    .ok_or("CLOUD_WEB_HOST_MISSING")?
+                    .join("config")
+                    .join("cloudweb-profiles"),
+            )
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::inherit());
+        // Hide only the Python/stdio console. The Qt browser window stays visible.
+        #[cfg(windows)]
+        {
+            use std::os::windows::process::CommandExt;
+            command.creation_flags(0x0800_0000);
+        }
+        let mut child = command.spawn().map_err(|_| "CLOUD_WEB_START_FAILED")?;
+        let Some(mut stdin) = child.stdin.take() else {
+            let _ = child.kill();
+            let _ = child.wait();
+            return Err("CLOUD_WEB_START_FAILED".into());
+        };
+        let Some(stdout) = child.stdout.take() else {
+            let _ = child.kill();
+            let _ = child.wait();
+            return Err("CLOUD_WEB_START_FAILED".into());
+        };
+        let healthy = Arc::new(AtomicBool::new(true));
+        let (response_tx, response_rx) = mpsc::sync_channel(1);
+        let reader_health = healthy.clone();
+        std::thread::spawn(move || {
+            let mut reader = BufReader::new(stdout);
+            loop {
+                let result = read_bounded_line(&mut reader, MAX_RESPONSE_BYTES).and_then(|line| {
+                    serde_json::from_slice::<HostReply>(&line)
+                        .map_err(|_| "CLOUD_WEB_PROTOCOL_ERROR".into())
+                });
+                let failed = result.is_err();
+                if failed {
+                    reader_health.store(false, Ordering::Release);
+                }
+                // The host must send exactly one response per request.
+                if response_tx.try_send(result).is_err() {
+                    reader_health.store(false, Ordering::Release);
+                    break;
+                }
+                if failed {
+                    break;
+                }
+            }
+        });
+        let (request_tx, request_rx) = mpsc::sync_channel::<HostRequest>(8);
+        let worker_health = healthy.clone();
+        std::thread::spawn(move || {
+            while let Ok(request) = request_rx.recv() {
+                if !worker_health.load(Ordering::Acquire) || Instant::now() >= request.deadline {
+                    let _ = request.reply.send(Err("CLOUD_WEB_DISCONNECTED".into()));
+                    continue;
+                }
+                let result = (|| {
+                    stdin
+                        .write_all(&request.line)
+                        .and_then(|_| stdin.flush())
+                        .map_err(|_| "CLOUD_WEB_DISCONNECTED".to_string())?;
+                    let timeout = request.deadline.saturating_duration_since(Instant::now());
+                    let response = response_rx
+                        .recv_timeout(timeout)
+                        .map_err(|_| "CLOUD_WEB_TIMEOUT".to_string())??;
+                    if response.id != request.id {
+                        return Err("CLOUD_WEB_PROTOCOL_ERROR".into());
+                    }
+                    Ok(response)
+                })();
+                if result.is_err() {
+                    worker_health.store(false, Ordering::Release);
+                }
+                let _ = request.reply.send(result);
+            }
+        });
+        Ok(Arc::new(Self {
+            child: Mutex::new(Some(child)),
+            requests: request_tx,
+            healthy,
+            ready: AtomicBool::new(false),
+            input_enabled: AtomicBool::new(true),
+            input_gate: Mutex::new(()),
+            request_gate: Mutex::new(()),
+            stop_epoch: AtomicU64::new(0),
+            pending_releases: AtomicUsize::new(0),
+            next_id: AtomicU64::new(1),
+            session_id: session_id.into(),
+        }))
+    }
+
+    fn request(&self, method: &str, params: Value, timeout: Duration) -> Result<Value, String> {
+        let deadline = Instant::now() + timeout;
+        let _guard = loop {
+            match self.request_gate.try_lock() {
+                Ok(guard) => break guard,
+                Err(std::sync::TryLockError::Poisoned(_)) => {
+                    return Err("CLOUD_WEB_PROTOCOL_ERROR".into())
+                }
+                Err(std::sync::TryLockError::WouldBlock) => {
+                    if Instant::now() >= deadline {
+                        return Err("CLOUD_WEB_BUSY".into());
+                    }
+                    std::thread::sleep(Duration::from_millis(5));
+                }
+            }
+        };
+        self.request_locked(
+            method,
+            params,
+            deadline.saturating_duration_since(Instant::now()),
+        )
+    }
+
+    fn request_locked(
+        &self,
+        method: &str,
+        params: Value,
+        timeout: Duration,
+    ) -> Result<Value, String> {
+        if !self.healthy.load(Ordering::Acquire) {
+            self.shutdown();
+            return Err("CLOUD_WEB_DISCONNECTED".into());
+        }
+        let id = self.next_id.fetch_add(1, Ordering::Relaxed);
+        let mut line = serde_json::to_vec(&json!({"id": id, "method": method, "params": params}))
+            .map_err(|_| "CLOUD_WEB_PROTOCOL_ERROR")?;
+        line.push(b'\n');
+        if line.len() > MAX_REQUEST_BYTES {
+            return Err("CLOUD_WEB_PROTOCOL_ERROR".into());
+        }
+        let (reply_tx, reply_rx) = mpsc::sync_channel(1);
+        let request = HostRequest {
+            id,
+            line,
+            deadline: Instant::now() + timeout,
+            reply: reply_tx,
+        };
+        if self.requests.try_send(request).is_err() {
+            self.shutdown();
+            return Err("CLOUD_WEB_PROTOCOL_ERROR".into());
+        }
+        match reply_rx.recv_timeout(timeout) {
+            Ok(Ok(reply)) if reply.ok => Ok(reply.result),
+            Ok(Ok(reply)) => {
+                // Do not forward untrusted webpage text, URLs, or credentials to logs.
+                let _ = reply.error;
+                Err("CLOUD_WEB_REJECTED".into())
+            }
+            Ok(Err(error)) => {
+                self.shutdown();
+                Err(error)
+            }
+            Err(_) => {
+                // A timeout cannot retract input already dispatched. Kill the
+                // session so queued/late commands cannot execute after failure.
+                self.shutdown();
+                Err("CLOUD_WEB_TIMEOUT".into())
+            }
+        }
+    }
+
+    fn action(&self, method: &str, params: Value) -> bool {
+        let Ok(_guard) = self.input_gate.lock() else {
+            return false;
+        };
+        if !self.input_enabled.load(Ordering::Acquire) && method != "inactive" {
+            return false;
+        }
+        self.request(method, params, ACTION_TIMEOUT)
+            .ok()
+            .and_then(|v| v.as_bool())
+            == Some(true)
+    }
+
+    /// Stop queued input without closing the page, so the next run can reuse it.
+    pub fn pause_and_release_input(&self) -> bool {
+        self.begin_stop();
+        self.finish_stop_release()
+    }
+
+    pub fn begin_stop(&self) {
+        self.input_enabled.store(false, Ordering::Release);
+        self.pending_releases.fetch_add(1, Ordering::AcqRel);
+        self.stop_epoch.fetch_add(1, Ordering::AcqRel);
+    }
+
+    pub fn finish_stop_release(&self) -> bool {
+        let result = match self.input_gate.lock() {
+            Ok(_guard) => {
+                self.request("inactive", json!({}), ACTION_TIMEOUT)
+                    .ok()
+                    .and_then(|v| v.as_bool())
+                    == Some(true)
+            }
+            Err(_) => false,
+        };
+        self.pending_releases.fetch_sub(1, Ordering::AcqRel);
+        result
+    }
+
+    pub fn stop_epoch(&self) -> u64 {
+        self.stop_epoch.load(Ordering::Acquire)
+    }
+
+    pub fn resume_input(&self) -> bool {
+        let Ok(_guard) = self.input_gate.try_lock() else {
+            return false;
+        };
+        if self.pending_releases.load(Ordering::Acquire) != 0
+            || !self.healthy.load(Ordering::Acquire)
+        {
+            return false;
+        }
+        self.input_enabled.store(true, Ordering::Release);
+        true
+    }
+
+    pub fn shutdown(&self) {
+        self.ready.store(false, Ordering::Release);
+        self.input_enabled.store(false, Ordering::Release);
+        // Normal idle shutdown gives Chromium time to persist login data.
+        // A failed/busy protocol still terminates immediately: pending input
+        // must not execute after a timeout. Do not call request() recursively.
+        let graceful = if let Ok(_gate) = self.request_gate.try_lock() {
+            if self.healthy.load(Ordering::Acquire) {
+                let id = self.next_id.fetch_add(1, Ordering::Relaxed);
+                let (reply, result) = mpsc::sync_channel(1);
+                let line = format!("{{\"id\":{id},\"method\":\"shutdown\",\"params\":{{}}}}\n")
+                    .into_bytes();
+                self.requests
+                    .try_send(HostRequest {
+                        id,
+                        line,
+                        deadline: Instant::now() + Duration::from_secs(3),
+                        reply,
+                    })
+                    .is_ok()
+                    && matches!(result.recv_timeout(Duration::from_secs(3)), Ok(Ok(response)) if response.ok)
+            } else {
+                false
+            }
+        } else {
+            false
+        };
+        self.healthy.store(false, Ordering::Release);
+        if let Ok(mut guard) = self.child.lock() {
+            if let Some(mut child) = guard.take() {
+                if graceful {
+                    let deadline = Instant::now() + Duration::from_secs(5);
+                    while matches!(child.try_wait(), Ok(None)) && Instant::now() < deadline {
+                        std::thread::sleep(Duration::from_millis(25));
+                    }
+                }
+                if !matches!(child.try_wait(), Ok(Some(_))) {
+                    let _ = child.kill();
+                }
+                let _ = child.wait();
+            }
+        }
+    }
+}
+
+impl Drop for CloudWebSession {
+    fn drop(&mut self) {
+        self.shutdown();
+    }
+}
+
+struct CloudWebCallback {
+    session: Weak<CloudWebSession>,
+}
+
+impl CloudWebCallback {
+    fn action(&self, method: &str, params: Value) -> bool {
+        self.session
+            .upgrade()
+            .is_some_and(|session| session.action(method, params))
+    }
+}
+
+impl CustomControllerCallback for CloudWebCallback {
+    fn connect(&self) -> bool {
+        self.session.upgrade().is_some_and(|session| {
+            let ready = session
+                .request("connect", json!({}), CONNECT_TIMEOUT)
+                .ok()
+                .and_then(|value| value.as_bool())
+                == Some(true);
+            session.ready.store(ready, Ordering::Release);
+            if !ready {
+                session.shutdown();
+            }
+            ready
+        })
+    }
+    fn connected(&self) -> bool {
+        self.session.upgrade().is_some_and(|session| {
+            if !session.healthy.load(Ordering::Acquire) {
+                // EOF is also emitted when the user closes the browser window.
+                // Reap its process on the next normal state poll.
+                session.shutdown();
+                return false;
+            }
+            if !session.ready.load(Ordering::Acquire) {
+                return false;
+            }
+            // Status reads can occur on the GUI thread while Maa is swiping.
+            // Never queue a short health-check timeout behind a long action.
+            let _guard = match session.request_gate.try_lock() {
+                Ok(guard) => guard,
+                Err(std::sync::TryLockError::WouldBlock) => return true,
+                Err(std::sync::TryLockError::Poisoned(_)) => return false,
+            };
+            session
+                .request_locked("connected", json!({}), STATUS_TIMEOUT)
+                .ok()
+                .and_then(|value| value.as_bool())
+                == Some(true)
+        })
+    }
+    fn request_uuid(&self) -> Option<String> {
+        self.session
+            .upgrade()
+            .map(|session| format!("cloudweb:{}", session.session_id))
+    }
+    fn screencap(&self) -> Option<Vec<u8>> {
+        let session = self.session.upgrade()?;
+        let value = session
+            .request("screencap", json!({}), ACTION_TIMEOUT)
+            .ok()?;
+        let data = STANDARD.decode(value.as_str()?).ok()?;
+        if !valid_viewport_png(&data) {
+            return None;
+        }
+        Some(data)
+    }
+    fn click(&self, x: i32, y: i32) -> bool {
+        self.action("click", json!({"x":x,"y":y}))
+    }
+    fn swipe(&self, x1: i32, y1: i32, x2: i32, y2: i32, duration: i32) -> bool {
+        self.action(
+            "swipe",
+            json!({"x1":x1,"y1":y1,"x2":x2,"y2":y2,"duration":duration}),
+        )
+    }
+    fn touch_down(&self, contact: i32, x: i32, y: i32, pressure: i32) -> bool {
+        self.action(
+            "touch_down",
+            json!({"contact":contact,"x":x,"y":y,"pressure":pressure}),
+        )
+    }
+    fn touch_move(&self, contact: i32, x: i32, y: i32, pressure: i32) -> bool {
+        self.action(
+            "touch_move",
+            json!({"contact":contact,"x":x,"y":y,"pressure":pressure}),
+        )
+    }
+    fn touch_up(&self, contact: i32) -> bool {
+        self.action("touch_up", json!({"contact":contact}))
+    }
+    fn click_key(&self, keycode: i32) -> bool {
+        self.action("click_key", json!({"keycode":keycode}))
+    }
+    fn key_down(&self, keycode: i32) -> bool {
+        self.action("key_down", json!({"keycode":keycode}))
+    }
+    fn key_up(&self, keycode: i32) -> bool {
+        self.action("key_up", json!({"keycode":keycode}))
+    }
+    fn input_text(&self, text: &str) -> bool {
+        self.action("input_text", json!({"text":text}))
+    }
+    fn scroll(&self, dx: i32, dy: i32) -> bool {
+        self.action("scroll", json!({"dx":dx,"dy":dy}))
+    }
+    fn relative_move(&self, dx: i32, dy: i32) -> bool {
+        self.action("relative_move", json!({"dx":dx,"dy":dy}))
+    }
+    fn inactive(&self) -> bool {
+        self.action("inactive", json!({}))
+    }
+    fn get_info(&self) -> String {
+        json!({"type":"cloudweb", "controller_type":"CloudWeb", "backend":"QtWebEngine",
+            "input_coordinate_space":"1280x720", "pointer_lock_supported":false})
+        .to_string()
+    }
+}
+
+/// The binding's C trampolines do not catch panics. Never unwind across FFI.
+struct GuardedCallback(CloudWebCallback);
+macro_rules! guarded_callback {
+    ($name:ident($($arg:ident : $ty:ty),*) -> $result:ty, $fallback:expr) => {
+        fn $name(&self, $($arg: $ty),*) -> $result {
+            std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| self.0.$name($($arg),*)))
+                .unwrap_or($fallback)
+        }
+    };
+}
+impl CustomControllerCallback for GuardedCallback {
+    guarded_callback!(connect() -> bool, false);
+    guarded_callback!(connected() -> bool, false);
+    guarded_callback!(request_uuid() -> Option<String>, None);
+    guarded_callback!(screencap() -> Option<Vec<u8>>, None);
+    guarded_callback!(click(x:i32,y:i32) -> bool, false);
+    guarded_callback!(swipe(x1:i32,y1:i32,x2:i32,y2:i32,duration:i32) -> bool, false);
+    guarded_callback!(touch_down(contact:i32,x:i32,y:i32,pressure:i32) -> bool, false);
+    guarded_callback!(touch_move(contact:i32,x:i32,y:i32,pressure:i32) -> bool, false);
+    guarded_callback!(touch_up(contact:i32) -> bool, false);
+    guarded_callback!(click_key(keycode:i32) -> bool, false);
+    guarded_callback!(key_down(keycode:i32) -> bool, false);
+    guarded_callback!(key_up(keycode:i32) -> bool, false);
+    guarded_callback!(input_text(text:&str) -> bool, false);
+    guarded_callback!(scroll(dx:i32,dy:i32) -> bool, false);
+    guarded_callback!(relative_move(dx:i32,dy:i32) -> bool, false);
+    guarded_callback!(inactive() -> bool, false);
+    guarded_callback!(get_info() -> String, "{}".to_string());
+}
+
+fn valid_viewport_png(data: &[u8]) -> bool {
+    data.len() >= 33
+        && data.len() <= MAX_RESPONSE_BYTES
+        && &data[..8] == b"\x89PNG\r\n\x1a\n"
+        && &data[12..16] == b"IHDR"
+        && u32::from_be_bytes([data[16], data[17], data[18], data[19]]) == 1280
+        && u32::from_be_bytes([data[20], data[21], data[22], data[23]]) == 720
+}
+
+pub fn create_controller(
+    url: &str,
+    session_id: &str,
+) -> Result<(Controller, Arc<CloudWebSession>), String> {
+    let session = open_browser(url, session_id)?;
+    let controller = controller_for_session(&session)?;
+    Ok((controller, session))
+}
+
+pub fn open_browser(url: &str, session_id: &str) -> Result<Arc<CloudWebSession>, String> {
+    #[cfg(windows)]
+    if super::system::is_elevated() && !url.is_empty() && url != "bundled-fixture" {
+        return Err("CLOUD_WEB_ELEVATED".into());
+    }
+    let root = super::utils::get_exe_directory().map_err(|_| "CLOUD_WEB_HOST_MISSING")?;
+    let name = if cfg!(windows) {
+        "CloudWebHost.exe"
+    } else {
+        "CloudWebHost"
+    };
+    CloudWebSession::spawn(&root.join("cloudweb-host").join(name), url, session_id)
+}
+
+pub fn controller_for_session(session: &Arc<CloudWebSession>) -> Result<Controller, String> {
+    let callback = CloudWebCallback {
+        session: Arc::downgrade(session),
+    };
+    Controller::new_custom(GuardedCallback(callback)).map_err(|_| "CLOUD_WEB_CREATE_FAILED".into())
+}
+
+/// Packaged, offline verification entrypoint. This deliberately uses the same
+/// Rust custom Controller factory and shipped resource bundle as the GUI.
+/// It does not load Python Maa bindings or start a second automation engine.
+pub fn run_fixture_smoke(report_path: &Path) -> Result<(), String> {
+    let root = super::utils::get_exe_directory()?;
+    let output = report_path
+        .parent()
+        .filter(|path| !path.as_os_str().is_empty())
+        .unwrap_or(Path::new("."));
+    std::fs::create_dir_all(output).map_err(|e| e.to_string())?;
+    let result = (|| -> Result<Value, String> {
+        let lib_dir = root.join("maafw");
+        #[cfg(windows)]
+        {
+            winsafe::SetDllDirectory(Some(&lib_dir.to_string_lossy()))
+                .map_err(|e| e.to_string())?;
+        }
+        let library_name = if cfg!(windows) {
+            "MaaFramework.dll"
+        } else if cfg!(target_os = "macos") {
+            "libMaaFramework.dylib"
+        } else {
+            "libMaaFramework.so"
+        };
+        maa_framework::load_library(&lib_dir.join(library_name))?;
+        let (controller, session) = create_controller("bundled-fixture", "native-fixture-smoke")?;
+        controller
+            .set_screenshot_target_short_side(720)
+            .map_err(|e| e.to_string())?;
+        let connection = controller.post_connection().map_err(|e| e.to_string())?;
+        wait_for_success(|| controller.status(connection), CONNECT_TIMEOUT, "connect")?;
+        if !controller.connected() {
+            return Err("Native controller did not connect".into());
+        }
+
+        let resource = maa_framework::resource::Resource::new().map_err(|e| e.to_string())?;
+        let load = resource
+            .post_bundle(&root.join("resource").to_string_lossy())
+            .map_err(|e| e.to_string())?;
+        wait_for_success(
+            || load.status(),
+            Duration::from_secs(60),
+            "load shipped resource",
+        )?;
+        let pipeline = json!({
+            "CloudWebFixtureClick": {"recognition":"DirectHit", "action":"Click", "target":[250,360,1,1],
+                "next":["CloudWebFixtureGreen"]},
+            "CloudWebFixtureGreen": {"recognition":"ColorMatch", "method":4,
+                "roi":[20,650,20,20], "lower":[[34,197,94]], "upper":[[34,197,94]], "count":300,
+                "action":"DoNothing", "timeout":10000},
+            "CloudWebFixtureSecondClick": {"recognition":"DirectHit", "action":"Click", "target":[250,360,1,1],
+                "next":["CloudWebFixtureBlue"]},
+            "CloudWebFixtureBlue": {"recognition":"ColorMatch", "method":4,
+                "roi":[20,650,20,20], "lower":[[59,130,246]], "upper":[[59,130,246]], "count":300,
+                "action":"DoNothing", "timeout":10000},
+            "CloudWebFixtureHold": {"recognition":"DirectHit", "action":"KeyDown", "key":16,
+                "next":["CloudWebFixtureWait"]},
+            "CloudWebFixtureWait": {"recognition":"ColorMatch", "method":4,
+                "roi":[20,650,20,20], "lower":[[255,255,255]], "upper":[[255,255,255]], "count":300,
+                "action":"DoNothing", "timeout":60000}
+        });
+        resource
+            .override_pipeline(&pipeline.to_string())
+            .map_err(|e| e.to_string())?;
+        let tasker = maa_framework::tasker::Tasker::new().map_err(|e| e.to_string())?;
+        tasker
+            .bind(&resource, &controller)
+            .map_err(|e| e.to_string())?;
+        if !tasker.inited() {
+            return Err("Native Tasker was not initialized".into());
+        }
+
+        let first = tasker
+            .post_task("CloudWebFixtureClick", "{}")
+            .map_err(|e| e.to_string())?;
+        wait_for_success(
+            || first.status(),
+            Duration::from_secs(30),
+            "first native Tasker click and pixel recognition",
+        )?;
+        save_native_screenshot(&controller, &output.join("native-tasker-first.png"))?;
+
+        let hold = tasker
+            .post_task("CloudWebFixtureHold", "{}")
+            .map_err(|e| e.to_string())?;
+        let start = Instant::now();
+        while hold.status() == maa_framework::MaaStatus::PENDING
+            && start.elapsed() < Duration::from_secs(5)
+        {
+            std::thread::sleep(Duration::from_millis(10));
+        }
+        let stop_id = tasker.post_stop().map_err(|e| e.to_string())?;
+        if !session.pause_and_release_input() {
+            return Err("Held-input release failed".into());
+        }
+        wait_for_success(
+            || {
+                maa_framework::MaaStatus(unsafe {
+                    maa_framework::sys::MaaTaskerStatus(tasker.raw(), stop_id)
+                })
+            },
+            Duration::from_secs(20),
+            "native Tasker stop",
+        )?;
+        if !controller.connected() {
+            return Err("Stop unexpectedly destroyed the browser".into());
+        }
+        if !session.resume_input() {
+            return Err("Could not resume released input".into());
+        }
+        let second = tasker
+            .post_task("CloudWebFixtureSecondClick", "{}")
+            .map_err(|e| e.to_string())?;
+        wait_for_success(
+            || second.status(),
+            Duration::from_secs(30),
+            "second native Tasker click and pixel recognition",
+        )?;
+        save_native_screenshot(&controller, &output.join("native-tasker-restarted.png"))?;
+        let inactive = controller.post_inactive().map_err(|e| e.to_string())?;
+        wait_for_success(|| controller.status(inactive), ACTION_TIMEOUT, "inactive")?;
+
+        // Destroy the native engine before reaping its view. A subsequent status
+        // request must fail closed rather than consume a stale screenshot.
+        drop(first);
+        drop(hold);
+        drop(second);
+        drop(tasker);
+        drop(resource);
+        drop(controller);
+        session.shutdown();
+        let reaped = session
+            .child
+            .lock()
+            .map_err(|_| "child mutex poisoned")?
+            .is_none();
+        if !reaped {
+            return Err("Browser child was not reaped".into());
+        }
+        Ok(
+            json!({"result":"passed", "engine":"MXU Rust MaaFramework Tasker", "offline_only":true,
+            "resource":"shipped resource bundle", "native_tasker_bound":true,
+            "first_click_pixel_verified":true, "stopped_without_closing_browser":true,
+            "restarted_click_pixel_verified":true, "child_reaped":true,
+            "screenshots":["native-tasker-first.png","native-tasker-restarted.png"],
+            "cloud_game_verified":false, "pointer_lock_verified":false}),
+        )
+    })();
+    let report = match &result {
+        Ok(value) => value.clone(),
+        Err(error) => {
+            json!({"result":"failed", "engine":"MXU Rust MaaFramework Tasker", "error":error})
+        }
+    };
+    std::fs::write(
+        report_path,
+        serde_json::to_vec_pretty(&report).map_err(|e| e.to_string())?,
+    )
+    .map_err(|e| e.to_string())?;
+    result.map(|_| ())
+}
+
+fn wait_for_success(
+    mut status: impl FnMut() -> maa_framework::MaaStatus,
+    timeout: Duration,
+    stage: &str,
+) -> Result<(), String> {
+    let start = Instant::now();
+    loop {
+        let current = status();
+        if current == maa_framework::MaaStatus::SUCCEEDED {
+            return Ok(());
+        }
+        if current == maa_framework::MaaStatus::FAILED
+            || current == maa_framework::MaaStatus::INVALID
+        {
+            return Err(format!("Native CloudWeb smoke failed: {stage}"));
+        }
+        if start.elapsed() >= timeout {
+            return Err(format!("Native CloudWeb smoke timed out: {stage}"));
+        }
+        std::thread::sleep(Duration::from_millis(20));
+    }
+}
+
+fn save_native_screenshot(controller: &Controller, path: &Path) -> Result<(), String> {
+    let id = controller.post_screencap().map_err(|e| e.to_string())?;
+    wait_for_success(|| controller.status(id), ACTION_TIMEOUT, "screenshot")?;
+    let data = controller
+        .cached_image()
+        .map_err(|e| e.to_string())?
+        .to_vec()
+        .ok_or("Native screenshot buffer was empty")?;
+    if !valid_viewport_png(&data) {
+        return Err("Native screenshot had incorrect geometry".into());
+    }
+    std::fs::write(path, data).map_err(|e| e.to_string())
+}
