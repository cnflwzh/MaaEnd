+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn mock_session() -> (Arc<CloudWebSession>, mpsc::Receiver<HostRequest>) {
+        let (requests, receiver) = mpsc::sync_channel(8);
+        (
+            Arc::new(CloudWebSession {
+                child: Mutex::new(None),
+                requests,
+                healthy: Arc::new(AtomicBool::new(true)),
+                ready: AtomicBool::new(true),
+                input_enabled: AtomicBool::new(true),
+                input_gate: Mutex::new(()),
+                request_gate: Mutex::new(()),
+                stop_epoch: AtomicU64::new(0),
+                pending_releases: AtomicUsize::new(0),
+                next_id: AtomicU64::new(1),
+                session_id: "test".into(),
+            }),
+            receiver,
+        )
+    }
+
+    #[test]
+    fn concurrent_status_does_not_timeout_a_long_action() {
+        let (session, requests) = mock_session();
+        let call_session = session.clone();
+        let action = std::thread::spawn(move || call_session.action("swipe", json!({})));
+        let request = requests.recv_timeout(Duration::from_secs(1)).unwrap();
+        let callback = CloudWebCallback {
+            session: Arc::downgrade(&session),
+        };
+        let before = Instant::now();
+        assert!(callback.connected());
+        assert!(before.elapsed() < Duration::from_millis(200));
+        assert!(session.healthy.load(Ordering::Acquire));
+        request
+            .reply
+            .send(Ok(HostReply {
+                id: request.id,
+                ok: true,
+                result: json!(true),
+                error: None,
+            }))
+            .unwrap();
+        assert!(action.join().unwrap());
+    }
+
+    #[test]
+    fn stop_blocks_resume_until_release_completes() {
+        let (session, requests) = mock_session();
+        let epoch = session.stop_epoch();
+        session.begin_stop();
+        assert_ne!(session.stop_epoch(), epoch);
+        assert!(!session.resume_input());
+        let releasing = session.clone();
+        let release = std::thread::spawn(move || releasing.finish_stop_release());
+        let request = requests.recv_timeout(Duration::from_secs(1)).unwrap();
+        assert!(!session.resume_input());
+        request
+            .reply
+            .send(Ok(HostReply {
+                id: request.id,
+                ok: true,
+                result: json!(true),
+                error: None,
+            }))
+            .unwrap();
+        assert!(release.join().unwrap());
+        assert!(session.resume_input());
+    }
+
+    #[test]
+    fn stop_rejects_input_already_waiting_for_gate() {
+        let (session, requests) = mock_session();
+        let gate = session.input_gate.lock().unwrap();
+        let pending = session.clone();
+        let action = std::thread::spawn(move || pending.action("click", json!({"x":1,"y":1})));
+        session.begin_stop();
+        drop(gate);
+        assert!(!action.join().unwrap());
+        assert!(requests.try_recv().is_err());
+    }
+
+    #[test]
+    fn response_timeout_faults_session() {
+        let (session, _requests) = mock_session();
+        assert!(session
+            .request("screencap", json!({}), Duration::from_millis(10))
+            .is_err());
+        assert!(!session.healthy.load(Ordering::Acquire));
+    }
+
+    #[test]
+    fn url_policy_rejects_privileged_and_credential_urls() {
+        for url in [
+            "http://example.com",
+            "file:///tmp/test",
+            "https://u:p@example.com",
+            "https://example.com:123",
+            "https://example.com/\nsecret",
+            "https://example.com\\@other.com",
+        ] {
+            assert!(normalized_url(url).is_err(), "{url}");
+        }
+        assert_eq!(normalized_url("").unwrap(), "bundled-fixture");
+        assert!(normalized_url("https://example.com/game").is_ok());
+    }
+
+    #[test]
+    fn protocol_line_is_bounded_and_requires_newline() {
+        assert_eq!(
+            read_bounded_line(&mut &b"{}\nremaining"[..], 3).unwrap(),
+            b"{}\n"
+        );
+        assert!(read_bounded_line(&mut &b"1234\n"[..], 4).is_err());
+        assert!(read_bounded_line(&mut &b"{}"[..], 10).is_err());
+    }
+
+    #[test]
+    fn png_must_match_fixed_input_viewport() {
+        let mut png = vec![0; 33];
+        png[..8].copy_from_slice(b"\x89PNG\r\n\x1a\n");
+        png[12..16].copy_from_slice(b"IHDR");
+        png[16..20].copy_from_slice(&1280u32.to_be_bytes());
+        png[20..24].copy_from_slice(&720u32.to_be_bytes());
+        assert!(valid_viewport_png(&png));
+        png[20..24].copy_from_slice(&1080u32.to_be_bytes());
+        assert!(!valid_viewport_png(&png));
+    }
+}
