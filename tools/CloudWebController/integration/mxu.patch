@@ -0,0 +1,48 @@
+import { useId } from 'react';
+import { useTranslation } from 'react-i18next';
+import clsx from 'clsx';
+import { isValidCloudWebUrl } from '@/utils/cloudWebController';
+
+interface CloudWebUrlInputProps {
+  value: string;
+  onChange: (value: string) => void;
+  disabled?: boolean;
+}
+
+/** The CloudWeb extension lives inside the existing connection panel. */
+export function CloudWebUrlInput({ value, onChange, disabled }: CloudWebUrlInputProps) {
+  const { t } = useTranslation();
+  const id = useId();
+  const invalid = !value.trim() || !isValidCloudWebUrl(value);
+  return (
+    <details className="flex-1 min-w-0 space-y-1.5">
+      <summary className="text-xs text-text-secondary cursor-pointer">
+        {t('controller.cloudWebAdvanced')}
+      </summary>
+      <label htmlFor={id} className="block text-xs text-text-secondary">
+        {t('controller.cloudWebUrl')}
+      </label>
+      <input
+        id={id}
+        type="url"
+        value={value}
+        onChange={(event) => onChange(event.target.value)}
+        placeholder={t('controller.cloudWebUrlPlaceholder')}
+        disabled={disabled}
+        autoComplete="off"
+        spellCheck={false}
+        aria-invalid={invalid}
+        aria-describedby={`${id}-hint`}
+        className={clsx(
+          'w-full min-w-0 px-2.5 py-1.5 rounded-md border bg-bg-tertiary text-sm',
+          'text-text-primary placeholder:text-text-muted focus:outline-none focus:border-accent transition-colors',
+          invalid ? 'border-error' : 'border-border',
+          disabled && 'opacity-60 cursor-not-allowed',
+        )}
+      />
+      <p id={`${id}-hint`} className={clsx('text-xs', invalid ? 'text-error' : 'text-text-muted')}>
+        {t(invalid ? 'controller.cloudWebInvalidUrl' : 'controller.cloudWebHint')}
+      </p>
+    </details>
+  );
+}
