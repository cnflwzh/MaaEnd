+++ b/tests/cloudWebController.test.ts
@@ -0,0 +1,79 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  buildCloudWebControllerConfig,
+  getCloudWebDeviceName,
+  getCloudWebErrorKey,
+  isValidCloudWebUrl,
+} from '../src/utils/cloudWebController.ts';
+
+test('CloudWeb default is the offline fixture, with a stable per-instance session', () => {
+  assert.deepEqual(buildCloudWebControllerConfig('instance-a'), {
+    type: 'CloudWeb',
+    url: '',
+    session_id: 'instance-a',
+  });
+  assert.deepEqual(
+    buildCloudWebControllerConfig('instance-a', '  '),
+    buildCloudWebControllerConfig('instance-a'),
+  );
+  assert.notEqual(
+    buildCloudWebControllerConfig('instance-a').session_id,
+    buildCloudWebControllerConfig('instance-b').session_id,
+  );
+  assert.throws(() => buildCloudWebControllerConfig(''), /INVALID_SESSION/);
+  assert.throws(() => buildCloudWebControllerConfig('../shared'), /INVALID_SESSION/);
+});
+
+test('CloudWeb accepts HTTPS public query parameters and trims outer spaces', () => {
+  for (const url of ['', 'https://example.com', 'https://example.com:443/game?region=cn#play']) {
+    assert.equal(isValidCloudWebUrl(url), true, url);
+  }
+  assert.equal(
+    buildCloudWebControllerConfig('instance-a', ' https://example.com/game ').url,
+    'https://example.com/game',
+  );
+});
+
+test('CloudWeb rejects invalid/non-TLS/credential-bearing and out-of-contract URLs', () => {
+  for (const url of [
+    null,
+    123,
+    'http://example.com',
+    'file:///tmp/test',
+    'javascript:alert(1)',
+    'https://user:pass@example.com',
+    'https://example.com:8443',
+    'https://exam ple.com',
+    'https://example.com/\ntest',
+    'https://例子.com',
+    'https://example.com/\\bad',
+    'https://example.com/' + 'a'.repeat(4096),
+  ]) {
+    assert.equal(isValidCloudWebUrl(url), false, String(url));
+  }
+  assert.throws(
+    () => buildCloudWebControllerConfig('instance-a', 'http://example.com'),
+    /INVALID_URL/,
+  );
+});
+
+test('CloudWeb device logs never include query or fragment login parameters', () => {
+  assert.equal(
+    getCloudWebDeviceName('https://example.com/play?token=secret#secret', 'fixture'),
+    'example.com',
+  );
+  assert.equal(getCloudWebDeviceName('', 'fixture'), 'fixture');
+  assert.equal(getCloudWebDeviceName(undefined, 'fixture'), 'fixture');
+});
+
+test('CloudWeb bridge errors are localized without echoing response data', () => {
+  assert.equal(
+    getCloudWebErrorKey(new Error('API failed: {"error":"CLOUD_WEB_HOST_MISSING"}')),
+    'controller.cloudWebHostMissing',
+  );
+  assert.equal(getCloudWebErrorKey('CLOUD_WEB_RECONNECT_RUNNING'), 'controller.cloudWebBusy');
+  assert.equal(getCloudWebErrorKey('CLOUD_WEB_RELEASE_FAILED'), 'controller.cloudWebReleaseFailed');
+  assert.equal(getCloudWebErrorKey('CLOUD_WEB_ELEVATED'), 'controller.cloudWebElevated');
+  assert.equal(getCloudWebErrorKey('unrelated error'), undefined);
+});
diff --git a/tests/cloudWebIntegration.test.ts b/tests/cloudWebIntegration.test.ts
new file mode 100644
index 0000000..3067fef
--- /dev/null
+++ b/tests/cloudWebIntegration.test.ts
@@ -0,0 +1,148 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { fileURLToPath } from 'node:url';
+import { createServer } from 'vite';
+import { createElement } from 'react';
+import { renderToStaticMarkup } from 'react-dom/server';
+
+/** Use Vite's existing TS/alias pipeline; no extra test framework or browser dependency. */
+test('CloudWeb integrates with the existing panel, platform filters and config lifecycle', async (t) => {
+  const previousStorage = Object.getOwnPropertyDescriptor(globalThis, 'localStorage');
+  const previousDocument = Object.getOwnPropertyDescriptor(globalThis, 'document');
+  const storage = new Map<string, string>([['mxu-language', 'zh-CN']]);
+  Object.defineProperty(globalThis, 'localStorage', {
+    configurable: true,
+    value: {
+      getItem: (key: string) => storage.get(key) ?? null,
+      setItem: (key: string, value: string) => storage.set(key, value),
+      removeItem: (key: string) => storage.delete(key),
+    },
+  });
+  const root = fileURLToPath(new URL('../', import.meta.url));
+  const server = await createServer({
+    root,
+    configFile: false,
+    logLevel: 'silent',
+    optimizeDeps: { noDiscovery: true, include: [] },
+    resolve: { alias: { '@': `${root}src` } },
+    server: { middlewareMode: true, watch: null },
+  });
+  try {
+    const { useAppStore, flushConfig } = await server.ssrLoadModule('/src/stores/appStore.ts');
+    const { getUnsupportedControllerTypes } = await server.ssrLoadModule(
+      '/src/services/interfaceLoader.ts',
+    );
+    const { requiresUnlockedWorkstation } = await server.ssrLoadModule('/src/utils/controller.ts');
+    const { buildCloudWebControllerConfig } = await server.ssrLoadModule(
+      '/src/utils/cloudWebController.ts',
+    );
+    const { buildTabConfigExportText, importTabConfigFromText } = await server.ssrLoadModule(
+      '/src/utils/tabExportImport.ts',
+    );
+    const { ConnectionPanel } = await server.ssrLoadModule('/src/components/ConnectionPanel.tsx');
+    const instance = {
+      id: 'cloudweb-a',
+      name: 'CloudWeb A',
+      controllerName: 'CloudWeb',
+      resourceName: 'Base',
+      savedDevice: { cloudWebUrl: 'https://example.com/play?region=cn#private' },
+      selectedTasks: [],
+      isRunning: false,
+    };
+    useAppStore.setState({
+      projectInterface: {
+        name: 'MaaEnd',
+        controller: [
+          { name: 'Win32', label: '桌面端', type: 'Win32' },
+          { name: 'CloudWeb', label: '云·终末地网页版', type: 'CloudWeb' },
+        ],
+        resource: [{ name: 'Base', path: ['resource'] }],
+        task: [],
+      },
+      instances: [instance],
+      activeInstanceId: instance.id,
+      selectedController: { [instance.id]: 'CloudWeb' },
+      selectedResource: { [instance.id]: 'Base' },
+      language: 'zh-CN',
+      connectionPanelExpanded: true,
+      configPersistenceReady: false,
+    });
+
+    await t.test('CloudWeb remains supported on Windows, macOS and Linux', () => {
+      for (const os of ['windows', 'macos', 'linux']) {
+        assert.equal(getUnsupportedControllerTypes(os).has('CloudWeb'), false, os);
+      }
+      assert.equal(requiresUnlockedWorkstation('CloudWeb'), false);
+    });
+
+    await t.test('existing connection panel renders CloudWeb chip and accessible URL input', () => {
+      // Zustand SSR intentionally reads its initial snapshot; supply our test fixture snapshot.
+      Object.assign(useAppStore.getInitialState(), useAppStore.getState());
+      const html = renderToStaticMarkup(createElement(ConnectionPanel));
+      assert.match(html, /id="connection-panel"/);
+      assert.match(html, /云·终末地网页版/);
+      assert.match(html, /云游戏网页地址/);
+      assert.match(html, /type="url"/);
+      assert.match(html, /value="https:\/\/example.com\/play\?region=cn#private"/);
+      assert.match(html, /留空使用/);
+      assert.doesNotMatch(html, /prototype/i);
+    });
+
+    await t.test(
+      'full configuration round-trip preserves URL, not a persisted session token',
+      () => {
+        useAppStore.setState({ configPersistenceReady: true });
+        const config = flushConfig();
+        useAppStore.setState({ configPersistenceReady: false });
+        assert.equal(config.instances[0].savedDevice.cloudWebUrl, instance.savedDevice.cloudWebUrl);
+        assert.equal('session_id' in config.instances[0].savedDevice, false);
+        Object.defineProperty(globalThis, 'document', {
+          configurable: true,
+          value: {
+            documentElement: {
+              style: { setProperty() {} },
+              classList: { toggle() {} },
+              setAttribute() {},
+            },
+          },
+        });
+
+        config.settings.helpImproveSoftware = false;
+        useAppStore.getState().importConfig(JSON.parse(JSON.stringify(config)));
+        const restored = useAppStore.getState().instances[0];
+        assert.equal(restored.savedDevice.cloudWebUrl, instance.savedDevice.cloudWebUrl);
+        assert.equal(
+          buildCloudWebControllerConfig(restored.id, restored.savedDevice.cloudWebUrl).session_id,
+          instance.id,
+        );
+        // Closed/reopened configurations get a new instance ID and therefore an isolated session.
+        useAppStore.getState().removeInstance(instance.id);
+        const reopenedId = useAppStore.getState().reopenRecentlyClosed(instance.id);
+        const reopened = useAppStore.getState().instances.find((item) => item.id === reopenedId);
+        assert.equal(reopened.savedDevice.cloudWebUrl, instance.savedDevice.cloudWebUrl);
+        assert.notEqual(
+          buildCloudWebControllerConfig(reopened.id, reopened.savedDevice.cloudWebUrl).session_id,
+          instance.id,
+        );
+      },
+    );
+
+    await t.test(
+      'tab-sharing preserves controller choice without sharing device URLs or sessions',
+      async () => {
+        const text = await buildTabConfigExportText(instance, 'MaaEnd');
+        const imported = await importTabConfigFromText('MaaEnd', text);
+        assert.equal(imported.payload.controllerName, 'CloudWeb');
+        assert.equal('savedDevice' in imported.payload, false);
+        assert.equal('session_id' in imported.payload, false);
+        assert.doesNotMatch(JSON.stringify(imported.payload), /example\.com|private/);
+      },
+    );
+  } finally {
+    await server.close();
+    if (previousStorage) Object.defineProperty(globalThis, 'localStorage', previousStorage);
+    else Reflect.deleteProperty(globalThis, 'localStorage');
+    if (previousDocument) Object.defineProperty(globalThis, 'document', previousDocument);
+    else Reflect.deleteProperty(globalThis, 'document');
+  }
+});
diff --git a/tests/cloudWebManifest.test.ts b/tests/cloudWebManifest.test.ts
new file mode 100644
index 0000000..41a69b9
--- /dev/null
+++ b/tests/cloudWebManifest.test.ts
@@ -0,0 +1,77 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyCloudWebManifest, parseCloudWebManifest } from '../src/utils/cloudWebManifest.ts';
+import type { ProjectInterface } from '../src/types/interface.ts';
+
+const source: ProjectInterface = {
+  interface_version: 2,
+  name: 'MaaEnd',
+  controller: [{ name: 'Win32-Front', type: 'Win32' }],
+  resource: [{ name: 'Base', path: ['resource'] }],
+  option: {
+    AutoCollectMode: { type: 'select', controller: ['Win32-Front'], cases: [{ name: 'all' }] },
+    NativeOnly: { type: 'select', controller: ['Win32-Front'], cases: [{ name: 'native' }] },
+  },
+  task: [
+    { name: 'allowed', entry: 'Start', controller: ['Win32-Front'] },
+    { name: 'unsupported', entry: 'NativeOnly' },
+  ],
+};
+const manifest = {
+  schema_version: 1,
+  controller: { name: 'CloudWeb', label: '云·终末地网页版' },
+  compatible_tasks: ['allowed'],
+  compatible_options: ['AutoCollectMode'],
+};
+
+test('client manifest adds runtime controller and only allowlisted task compatibility', () => {
+  const original = JSON.parse(JSON.stringify(source));
+  const runtime = applyCloudWebManifest(source, manifest);
+  assert.deepEqual(source, original);
+  assert.deepEqual(runtime.controller[1], {
+    name: 'CloudWeb',
+    label: '云·终末地网页版',
+    type: 'CloudWeb',
+  });
+  assert.deepEqual(runtime.task[0].controller, ['Win32-Front', 'CloudWeb']);
+  assert.deepEqual(runtime.task[1].controller, ['Win32-Front']);
+  assert.notEqual(runtime.task[0], source.task[0]);
+  assert.deepEqual(runtime.option?.AutoCollectMode.controller, ['Win32-Front', 'CloudWeb']);
+  assert.deepEqual(runtime.option?.NativeOnly.controller, ['Win32-Front']);
+  assert.notEqual(runtime.option?.AutoCollectMode, source.option?.AutoCollectMode);
+});
+
+test('client manifest rejects unexpected fields, PI type masquerading and stale allowlists', () => {
+  for (const value of [
+    null,
+    [],
+    {},
+    { ...manifest, schema_version: 2 },
+    { ...manifest, executable: 'injected.exe' },
+    { ...manifest, controller: { ...manifest.controller, type: 'Win32' } },
+    { ...manifest, compatible_tasks: ['allowed', 'allowed'] },
+    { ...manifest, compatible_options: ['AutoCollectMode', 'AutoCollectMode'] },
+    { ...manifest, compatible_options: ['AutoCollectMode', 12] },
+  ]) {
+    assert.throws(() => parseCloudWebManifest(value), /INVALID_MANIFEST/);
+  }
+  assert.throws(
+    () => applyCloudWebManifest(source, { ...manifest, compatible_tasks: ['missing'] }),
+    /UNKNOWN_COMPATIBLE_TASK/,
+  );
+  assert.throws(
+    () =>
+      applyCloudWebManifest(
+        { ...source, controller: [{ name: 'CloudWeb', type: 'Win32' }] },
+        manifest,
+      ),
+    /NAME_CONFLICT/,
+  );
+});
+
+test('client manifest rejects unknown option names', () => {
+  assert.throws(
+    () => applyCloudWebManifest(source, { ...manifest, compatible_options: ['missing'] }),
+    /UNKNOWN_COMPATIBLE_OPTION/,
+  );
+});
